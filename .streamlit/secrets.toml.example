# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Community Cloud → App settings → Secrets.

# Supabase → Project Settings → API Keys. The publishable (or legacy anon) key is safe for the app;
# never use the secret / service_role key here.
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_..."

# Where Supabase's Google flow sends people back to (only used without the [auth] section below)
APP_URL = "https://squareanalysis.streamlit.app"

# Optional: lets Claude plan the AI analyst's metric calls and read receipts
# ANTHROPIC_API_KEY = "sk-ant-..."

# Top-level keys must come before the [auth] tables below.

# "Continue with Google" through Streamlit's st.login: the consent screen shows the app's own address.
# Supabase's Google provider must list this client ID and have "Skip nonce check" on.
[auth]
redirect_uri = "https://squareanalysis.streamlit.app/oauth2callback"
cookie_secret = "generate with: python -c \"import secrets; print(secrets.token_urlsafe(32))\""
expose_tokens = ["id"]

[auth.google]
client_id = "YOUR-CLIENT-ID.apps.googleusercontent.com"
client_secret = "YOUR-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
