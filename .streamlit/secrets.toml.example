# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Community Cloud → App settings → Secrets.

# Supabase → Project Settings → API. The anon/publishable key is safe for the app; never use the service_role key here.
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."

# Optional: lets Claude plan the AI analyst's metric calls and read receipts
# ANTHROPIC_API_KEY = "sk-ant-..."
